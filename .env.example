# Configuración de ejemplo para SQL Server (no incluir credenciales reales)
SQLSERVER_HOST=EFE\SQLEXPRESS
SQLSERVER_PORT=1433
SQLSERVER_OLTP_DB=ColoresyCreaciones
SQLSERVER_DW_DB=DW_ColoresyCreaciones
SQLSERVER_USER=tu_usuario_ejemplo
SQLSERVER_PASSWORD=cambiar_por_contrasena_local

# Configuración de ejemplo para Apache Spark / Parquet
SPARK_APP_NAME=RE6_ColoresyCreaciones_Colab
PARQUET_INPUT_PATH=/content/drive/MyDrive/Colab_RE6_Resultados/dw_colores_1M.parquet
PARQUET_OUTPUT_PATH=/content/drive/MyDrive/Colab_RE6_Resultados/

# Configuración de ejemplo para MongoDB (solo fuente documental sin lógica compleja adicional)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=colores_creaciones
MONGO_COLLECTION=detallespersonalizados

# Marcador de ejemplo para seudonimización (no colocar la sal real en el repositorio)
HASH_SALT_PLACEHOLDER=reemplazar_en_entorno_local